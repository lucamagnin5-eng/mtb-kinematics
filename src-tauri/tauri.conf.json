{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atelier cinématique MTB",
  "version": "0.1.0",
  "identifier": "com.lucamagnin.mtbkinematics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Atelier cinématique MTB", "width": 1440, "height": 920, "minWidth": 960, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Géométrie et cinématique VTT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["mtbk"], "name": "Projet cinématique MTB", "role": "Editor", "mimeType": "application/json" }
    ]
  }
}
